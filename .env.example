# Azure AI Speech Configuration (AI-103 Capability 1: Speech)
# Obtain from Azure Portal -> Cognitive Services -> Azure AI Speech resource
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Microsoft Foundry / Azure OpenAI Model Configuration (AI-103 Capability 2: Generative AI)
# Obtain from Microsoft Foundry portal or Azure OpenAI Studio
FOUNDRY_ENDPOINT=https://your-foundry-resource.openai.azure.com/
FOUNDRY_API_KEY=your_foundry_api_key_here
FOUNDRY_MODEL=gpt-4o

# Application Configuration
NEXT_PUBLIC_APP_NAME="AI Interview Coach"
NEXT_PUBLIC_APP_TAGLINE="Rehearse before the real interview."
# Force mock demo mode even if Azure credentials exist (true/false)
NEXT_PUBLIC_FORCE_DEMO_MODE=false
